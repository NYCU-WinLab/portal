{
  "name": "winlab-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "actions:check": "bun scripts/check-actions.ts",
    "api:contract": "bun scripts/api-contract.ts",
    "api:check": "bun test scripts && bun scripts/api-contract.ts --check",
    "tokens:check": "bun scripts/check-tokens.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/cimd": "^1.7.7",
    "@better-auth/mcp": "^1.7.7",
