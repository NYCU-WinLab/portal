exports[`verify 1`] = `
{
  "html": 
"<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<style>
@media (prefers-color-scheme: dark) {
  body, .page { background: #0a0a0a !important; color: #fafafa !important; }
  .muted { color: #a1a1a1 !important; }
  .rule { border-color: #262626 !important; }
  .link { color: #fafafa !important; }
  .action { background: #5e94ff !important; color: #0a0a0a !important; }
  .secondary { color: #fafafa !important; border-color: #262626 !important; }
}
</style>
</head>
<body style="margin:0;padding:0;background:#ffffff;color:#0a0a0a">
<div class="page" style="background:#ffffff;color:#0a0a0a;font-family:Inter, "Noto Sans TC", -apple-system, BlinkMacSystemFont, "PingFang TC", "Microsoft JhengHei", sans-serif;font-size:16px;line-height:1.6">
<div style="max-width:560px;margin:0 auto;padding:40px 24px">
<h1 style="margin:0 0 24px;font-size:24px;line-height:1.3;font-weight:600">確認你的 Email</h1>

<p style="margin:0 0 16px">請按下按鈕確認這個 Email，確認後才會送出你的帳號申請。</p>
<p style="margin:24px 0 16px"><a class="action" href="https://apply.example.test/confirm?token=tok_ABC-123_abcdefghijklmnopqrstuvwxyz0123456" style="display:inline-block;margin:0 8px 8px 0;padding:10px 20px;border:1px solid #0033a0;border-radius:16px;background:#0033a0;color:#fafafa;font-weight:500;text-decoration:none">確認 Email</a></p>
<p class="muted rule" style="margin:40px 0 0;padding-top:16px;border-top:1px solid #e5e5e5;color:#737373"><a class="muted" href="https://portal.example.test" style="color:#737373;text-decoration:none">WinLab Portal</a></p>
</div>
</div>
</body>
</html>"
,
  "kind": "verify",
  "subject": "確認你的 Email",
  "text": 
"確認你的 Email

請按下按鈕確認這個 Email，確認後才會送出你的帳號申請。

確認 Email：https://apply.example.test/confirm?token=tok_ABC-123_abcdefghijklmnopqrstuvwxyz0123456"
,
  "to": "applicant@example.com",
}
`;

