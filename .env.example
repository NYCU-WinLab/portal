# --- Deployment (compose) ---
# Image tag: main, sha-<7>, or a release.
PORTAL_VERSION=main
# Where web listens on the host.
PORTAL_BIND=127.0.0.1
PORTAL_PORT=3000
POSTGRES_PASSWORD=

# --- Sign-in ---
# The public URL; also the MCP resource (<url>/mcp) and issuer base.
BETTER_AUTH_URL=https://portal.example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# A confidential OIDC client in your Keycloak realm, redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/keycloak.
KEYCLOAK_ISSUER=https://auth.example.com/realms/example
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# --- Observability (optional; off when the endpoint is empty) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=portal

# --- Mail (optional; queued mail waits while SMTP_HOST is empty) ---
# Google Workspace: SMTP_USER is the mailbox, SMTP_PASSWORD its app password,
# MAIL_FROM an alias of that mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=WinLab Portal <noreply@winlab.tw>
# Dev and test: every mail goes to this address only.
MAIL_REDIRECT_TO=

# --- Door (optional; the button says 門禁沒有設定 while empty) ---
# The door relay (ESP32) and its bearer token.
DOOR_API_URL=
DOOR_API_SECRET=
# The greeting service at the door (LED panel and HomePod).
DISPLAY_API_URL=
DISPLAY_API_SECRET=
# hams-bridge's token for POST /api/door/events (card swipes), 32+ chars.
HAMS_EVENTS_SECRET=

# --- Rooms (optional) ---
# The CS department's meeting room system and the lab's shared account
# there. Without the account, /rooms only opens online meetings.
MEETINGROOM_URL=https://www.cs.nycu.edu.tw/csauto/meetingroom
MEETINGROOM_SERVICE_USER=
MEETINGROOM_SERVICE_PASSWORD=
# GitLab: a read_api token for the booking form's epics, and the trigger
# token of the pipeline (project 177) that creates and cancels Teams
# meetings. Without the trigger token, bookings get no Teams meeting.
GITLAB_API_URL=https://gitlab.winlab.tw
GITLAB_API_TOKEN=
GITLAB_MEETING_TRIGGER_TOKEN=
# GitLab reads GET /api/rooms/bookings with this bearer token.
ROOMS_API_SECRET=
